{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map_entry.schema.json",
  "title": "ET81 source map row",
  "type": "object",
  "additionalProperties": false,
  "required": ["keyword", "prefer", "trust"],
  "properties": {
    "keyword": { "type": "string", "minLength": 1 },
    "prefer": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "avoid": {
      "type": "array",
      "items": { "type": "string" }
    },
    "trust": {
      "type": "string",
      "enum": ["candidate", "observed", "verified", "stale"]
    },
    "module_id": { "type": "string" },
    "source_task": { "type": "string" }
  }
}
