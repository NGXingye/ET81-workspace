  "facts": [
    {
      "id": "range_rings",
      "note": "DetectionRange=相对自身看见；ChaseRange=相对出生点软拴绳（出窝且目标也不在侦测才脱战）；attack_range/min_attack_range=追击停步出手带。attack_range 不选技能。",
      "trust": "verified",
      "source_task": "t006"
    },
    {
      "id": "get_attack_distance",
      "note": "有效距离=max(表距离,自身半径)+目标半径。表距离改 0 仍是贴身，不能用来禁用近战技能。",
      "trust": "verified",
      "source_task": "t006"
    },
    {
      "id": "range_design_order",
      "note": "先定技能起手 attack_distance，再定 min_attack_range（近战 0~1），attack_range 对齐或略大于起手，然后 DetectionRange、ChaseRange。基线：0 ≤ min_attack_range < 技能有效距离 ≤ attack_range ≤ DetectionRange ≤ ChaseRange。",
      "trust": "verified",
      "source_task": "t013"
    }
